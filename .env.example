# MinIO admin credentials (also passed to Spark's S3A client). Placeholder
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme

# Resources given to the Spark worker's JVM (spark.worker.cores / spark.worker.memory).
# bronze-ingestion's launcher (jobs/bronze_ingestion/launcher.py) divides both
# evenly across KAFKA_TOPICS so every topic's job gets a fair, nonzero share -
# an uncapped Spark app otherwise grabs everything and starves the rest.
# Each executor needs >=512m (Spark's own hard floor - INVALID_EXECUTOR_MEMORY
# below ~450m), so topic_count * 512m is the minimum SPARK_WORKER_MEMORY for
# every topic to run concurrently; below that, extra topics queue and wait
# for a slot instead of erroring. Keep SPARK_WORKER_MEMORY a bit under
# SPARK_WORKER_MEMORY_LIMIT (leave headroom for JVM/OS overhead), and keep
# SPARK_WORKER_MEMORY_LIMIT within what the Docker host actually has free.
# Rule of thumb: SPARK_WORKER_MEMORY >= (number of KAFKA_TOPICS) * 512m, and
# SPARK_WORKER_MEMORY_LIMIT a bit above that (JVM/OS overhead). With 8 topics
# that's ~4G worker / ~4.5G limit - make sure the Docker host has the RAM.
SPARK_WORKER_CORES=2
SPARK_WORKER_MEMORY=2G

# SPARK_WORKER_CPU_LIMIT=3
# SPARK_WORKER_MEMORY_LIMIT=3G

# Bronze ingestion job (jobs/bronze_ingestion) — central Kafka cluster and
# Confluent Schema Registry (Avro-encoded topics; see jobs/bronze_ingestion/README.md)
KAFKA_BOOTSTRAP_SERVERS=YOUR_KAFKA_HOST:9092
# NOTE: transactional.returns_refunds is intentionally omitted until its
# `-value` subject exists in the Schema Registry (missing -> HTTP 404 crash loop).
KAFKA_TOPICS=transactional.categories,transactional.products,transactional.users,transactional.orders,transactional.order_items,transactional.product_price_history,behavioral.events
SCHEMA_REGISTRY_URL=http://YOUR_SCHEMA_REGISTRY_HOST:8081

# KAFKA_STARTING_OFFSETS=earliest
# Micro-batch cadence. Keep it short (seconds) - a long interval throttles
# throughput to maxOffsetsPerTrigger/interval regardless of machine speed, so
# a backlog that could drain in seconds trickles for minutes. Empty batches
# are skipped, so a short interval costs nothing once caught up.
# TRIGGER_INTERVAL=15 seconds
# LOG_LEVEL=INFO
# MINIO_BUCKET=bronze

# Airflow's metadata database (dedicated postgres-airflow instance) and admin
# login. CHANGE THESE before any real deployment -- placeholders only, same
# as MINIO_ROOT_PASSWORD above.
POSTGRES_USER=airflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=airflow

AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=changeme
AIRFLOW_ADMIN_FIRSTNAME=Admin
AIRFLOW_ADMIN_LASTNAME=User
AIRFLOW_ADMIN_EMAIL=admin@example.com
# Fernet key encrypts connection passwords Airflow stores in postgres. Leave
# unset here -- generate your own per deployment, never reuse one across
# environments or commit a real one:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=
AIRFLOW_WEBSERVER_SECRET_KEY=changeme
# API server secrets (Flask session signing + internal JWT auth between
# airflow components). Any random string works, e.g.:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_API_SECRET_KEY=changeme
AIRFLOW_JWT_SECRET=changeme
AIRFLOW_PORT=8090

# Iceberg REST catalog (iceberg-rest) metadata store -- the system of record for
# every silver table. Backed by its own postgres (postgres-iceberg) rather than
# the airflow one: an airflow metadata reset must not be able to take the
# lakehouse catalog with it. See README.md ("Iceberg catalog") for why the
# image's SQLite default is not usable here.
ICEBERG_DB_USER=iceberg
ICEBERG_DB_PASSWORD=changeme
ICEBERG_DB_NAME=iceberg

# Silver layer (jobs/silver, Polars + PyIceberg). All optional -- the code
# defaults to the in-network service addresses. MINIO_BUCKET is the bronze
# source bucket (the real data lives in `bronze`, not `lakehouse`).
MINIO_BUCKET=bronze
# WAREHOUSE_BUCKET=warehouse
# MINIO_ENDPOINT=http://minio:9000
# ICEBERG_REST_URI=http://iceberg-rest:8181
# Facts reprocess [interval_start - N days, interval_end] each run so late
# arrivals are picked up and re-runs converge (dynamic partition overwrite).
SILVER_LOOKBACK_DAYS=3

# ClickHouse admin login. Placeholder values only.
CLICKHOUSE_USER=admin
CLICKHOUSE_PASSWORD=changeme

# Metabase (BI dashboard) - optional, host port defaults to 3000
# MB_PORT=3000

# Metabase admin account. Required by the `provision` profile, which builds the
# ClickHouse connection and every dashboard from metabase/questions/*.sql:
#   docker compose --profile provision run --rm metabase-init
MB_ADMIN_EMAIL=admin@example.com
MB_ADMIN_PASSWORD=changeme

# ClickHouse database holding the dbt gold OBT tables. dbt's default
# generate_schema_name concatenates profiles.yml `schema` with dbt_project.yml
# `+schema`, so the tables can land in `gold_gold` rather than `gold`. Confirm:
#   docker compose exec clickhouse clickhouse-client -q 'SHOW DATABASES'
# GOLD_DB=gold

# Real-time monitoring (clickhouse/init/10-realtime-monitoring.sh): how long the
# Kafka-sourced monitoring tables keep rows before the TTL drops them.
# MONITORING_RETENTION_HOURS=48