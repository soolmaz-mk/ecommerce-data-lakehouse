
KAFKA_BOOTSTRAP_SERVERS=185.255.90.14:9092
KAFKA_TOPICS=transactional.categories,transactional.products,transactional.users,transactional.orders,transactional.order_items,transactional.returns_refunds,transactional.product_price_history,behavioral.events
# Confluent Schema Registry backing the topics above — every message is
# Avro-encoded, not JSON (see transformation.py).
SCHEMA_REGISTRY_URL=http://185.255.90.14:8081

# Everything below is optional — shown commented-out with BronzeConfig's
# actual default (config.py), so uncomment only to override it for a local run.
# Dedicated bronze bucket: data at s3a://bronze/<topic>, failures at
# s3a://bronze/_dlq/<topic>, checkpoints at s3a://bronze/_checkpoints/<topic>.
# KAFKA_STARTING_OFFSETS=earliest
# MINIO_BUCKET=bronze
# BRONZE_PATH=
# DLQ_PATH=_dlq
# CHECKPOINT_PATH=_checkpoints
# SPARK_APP_NAME=bronze-ingestion
# TRIGGER_INTERVAL=30 seconds
# LOG_LEVEL=INFO
